# Copy to .env.local (ignored by git). Never put secrets here: every VITE_* value is public in the bundle.

# API Gateway (Kong). In development Vite proxies /iam, /business-api, /radar,
# /messaging (WebSocket included), /reservation-api and /community to this URL.
VITE_API_GATEWAY_URL=http://localhost:8000

# Reservation and Community have no API yet, so their services run on mocks.
VITE_MOCK_RESERVATION=true
VITE_MOCK_COMMUNITY=true
