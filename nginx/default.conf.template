# Rendered by the nginx image with envsubst at start-up. ${API_GATEWAY_HOST} (host:port of Kong)
# is the only variable of ours; the $variables below belong to nginx and are left alone.

# WebSocket upgrade for /messaging/ws (STOMP).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API: forwarded to Kong so the browser stays on one origin (no CORS) --------------------
    # "/radar/" has a trailing slash on purpose: "/radar" (no slash) is the SPA page of the Radar
    # screen and must fall through to index.html, while "/radar/search" is the API.
    location ~ ^/(iam|business-api|messaging|reservation-api|community)(/|$) {
        proxy_pass http://${API_GATEWAY_HOST};
        include /etc/nginx/api-proxy.conf;
    }
    # Without this exact match nginx would 301 "/radar" to "/radar/" (the API location below).
    location = /radar {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location /radar/ {
        proxy_pass http://${API_GATEWAY_HOST};
        include /etc/nginx/api-proxy.conf;
    }

    # --- static assets: content-hashed by Vite, cache for a year ---------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached, or a new deploy would keep loading old hashed assets.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # --- SPA fallback: any other path is a client-side route ------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
